# Mode 0600, outside Git. Raw KEY=value syntax; no quotes or shell expansion.
# Percent-encode the password in the URL. Use a fresh standalone cluster only.
DATABASE_URL=postgresql+psycopg://mediaos_runtime:REPLACE@postgres:5432/mediaos
# Populate with the separate INGESTOR credential map after first seed.
# INTELLIGENCE_TOKENS={"tenant-uuid":"server-only-ingestor-token"}
# No migration/admin credentials, local seed file or paid credentials belong here.
