# NONSECRET interpolation only. Copy outside the checkout and replace every value.
# All images require independently verified sha256 digests, not mutable tags.
API_IMAGE=registry.example.invalid/mediaos-api@sha256:REPLACE
CONSOLE_IMAGE=registry.example.invalid/mediaos-console@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
CADDY_IMAGE=caddy@sha256:REPLACE
SITE_DOMAIN=mediaos.example.invalid
ACME_EMAIL=operator@example.invalid
# Restricts direct /v1 API maintenance access only. Public UI uses account login.
# Keep this narrow; do not use an all-address network to enable ordinary users.
OPS_ALLOWED_CIDRS=192.0.2.10/32
# Optional authenticated Creator Studio setup; set true explicitly for the internal pilot.
# This does not enable public signup, paid generation, social actions or automatic publishing.
ENABLE_EXTERNAL_CREATORS=false
MEDIAOS_STATE_DIR=/srv/mediaos/state
MEDIAOS_TLS_DIR=/srv/mediaos/tls
POSTGRES_VOLUME=mediaos_standalone_postgres
RUNTIME_ENV_FILE=/etc/mediaos/runtime.env
MAINTENANCE_ENV_FILE=/etc/mediaos/maintenance.env
POSTGRES_PASSWORD_FILE=/etc/mediaos/postgres_admin_password
