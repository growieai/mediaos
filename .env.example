APP_ENV=development
AI_MOCK_MODE=true
# scripts/dev.py setup replaces these local placeholders with random credentials.
POSTGRES_ADMIN_PASSWORD=replace-via-setup
POSTGRES_RUNTIME_PASSWORD=replace-via-setup
DATABASE_URL=postgresql+psycopg://mediaos_runtime:replace-via-setup@127.0.0.1:55433/mediaos
MIGRATION_DATABASE_URL=postgresql+psycopg://mediaos_admin:replace-via-setup@127.0.0.1:55433/mediaos
TEST_DATABASE_URL=postgresql+psycopg://mediaos_runtime:replace-via-setup@127.0.0.1:55433/mediaos_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://mediaos_admin:replace-via-setup@127.0.0.1:55433/mediaos_test
ENABLE_EXTERNAL_CREATORS=false
ENABLE_AUTO_PUBLISH=false
ENABLE_AUTO_REPLIES=false
ENABLE_VIDEO=false
# Speaking-video execution is independently gated; default makes no paid calls.
# Leave AI_MOCK_MODE=true: text skills retain their verified deterministic contracts.
MEDIA_LIVE_ENABLED=false
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=
# Optional cutaway adapter only; not dispatched by the speaking-video workflow yet.
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
# MEDIA_STORAGE_PATH=/private/media
# Also configure an ADMIN media profile (voice + verified account rates) and
# an enabled, expiring spend policy through /v1 before any provider call.
# Production: JSON tenant UUID -> dedicated INGESTOR bearer token, supplied by secret manager.
# Local seed writes the separate ignored .local/ingestion-credentials.json file.
# INTELLIGENCE_TOKENS={"tenant-uuid":"secret-ingestor-token"}
# Real text skills additionally require an ADMIN tenant model policy with current
# prices and an expiring budget. Mock mode remains the safe local default.
# OPENAI_API_KEY=

# Consent-reviewed handoff: exact destination/transport must first be provisioned
# by the standalone database administrator. Never point this at Growie production.
# This flag alone does not authorize delivery; each payload needs human review.
CONVERSION_DELIVERY_ENABLED=false
# Secret-manager JSON mapping provisioned transport UUIDs to signing secrets:
# CONVERSION_DELIVERY_CREDENTIALS={"transport-uuid":"dedicated-signing-secret"}

# Instagram Login integration: all external actions are disabled by default.
# Keep ENABLE_AUTO_PUBLISH=false and ENABLE_AUTO_REPLIES=false; these flags below
# enable only explicit, separately human-authorized internal operations.
SOCIAL_CONNECT_ENABLED=false
SOCIAL_PUBLISH_ENABLED=false
SOCIAL_REPLY_ENABLED=false
# Configure privately after creating the Instagram app and professional account.
# No API version default is supplied: verify a supported version in Meta's docs.
# SOCIAL_APP_ID=
# SOCIAL_APP_SECRET=
# SOCIAL_API_VERSION=
# SOCIAL_REDIRECT_URI=https://mediaos.example.org/v1/social/oauth/callback
# SOCIAL_PUBLIC_BASE_URL=https://mediaos.example.org
# Dedicated random secret >=32 characters; protect/backup separately from the DB.
# SOCIAL_VAULT_KEY=
# SOCIAL_WEBHOOK_VERIFY_TOKEN=
# Production secret-manager JSON: tenant UUID -> dedicated SOCIAL principal token.
# Development seed writes ignored .local/social-credentials.json instead.
# SOCIAL_SERVICE_TOKENS={"tenant-uuid":"secret-social-service-token"}
# SOCIAL_STORAGE_PATH=/private/social
