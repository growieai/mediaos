APP_ENV=development
APP_NAME=Growie Media OS
API_HOST=0.0.0.0
API_PORT=8000

# AI runtime
OPENAI_API_KEY=
OPENAI_MODEL_EDITOR=gpt-5.6-terra
OPENAI_MODEL_RESEARCH=gpt-5.6-terra
OPENAI_MODEL_CREATOR=gpt-5.6-terra
OPENAI_MODEL_QA=gpt-5.6-sol
AI_MOCK_MODE=true

# Data
DATABASE_URL=postgresql+psycopg://growie:growie@postgres:5432/growie_media
REDIS_URL=redis://redis:6379/0

# Object storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=growie-media

# Workflows
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Product flags
ENABLE_EXTERNAL_CREATORS=false
ENABLE_AUTO_PUBLISH=false
ENABLE_AUTO_REPLIES=false
ENABLE_VIDEO=false
