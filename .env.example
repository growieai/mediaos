APP_ENV=development
AI_MOCK_MODE=true
# scripts/dev.py setup replaces these local placeholders with random credentials.
POSTGRES_ADMIN_PASSWORD=replace-via-setup
POSTGRES_RUNTIME_PASSWORD=replace-via-setup
DATABASE_URL=postgresql+psycopg://mediaos_runtime:replace-via-setup@127.0.0.1:55433/mediaos
MIGRATION_DATABASE_URL=postgresql+psycopg://mediaos_admin:replace-via-setup@127.0.0.1:55433/mediaos
TEST_DATABASE_URL=postgresql+psycopg://mediaos_runtime:replace-via-setup@127.0.0.1:55433/mediaos_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://mediaos_admin:replace-via-setup@127.0.0.1:55433/mediaos_test
ENABLE_EXTERNAL_CREATORS=false
ENABLE_AUTO_PUBLISH=false
ENABLE_AUTO_REPLIES=false
ENABLE_VIDEO=false
